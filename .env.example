# ============================================================
# WeChat Bot - 微信 Claude/Codex 机器人 配置文件
# 复制此文件为 .env 并修改对应配置: cp .env.example .env
# ============================================================

# --- AI 后端选择 ---
# 可选: anthropic | local | claude-cli
BACKEND_TYPE=anthropic

# --- Anthropic API (BACKEND_TYPE=anthropic 时使用) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# 自定义 API 地址（DeepSeek / 代理 等），留空使用官方
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 本地 HTTP 端点 (BACKEND_TYPE=local 时使用) ---
# 适用于 Ollama / vLLM / LocalAI 等本地服务
LOCAL_ENDPOINT_URL=http://localhost:11434/v1/chat/completions
# 端点格式: openai (OpenAI兼容) | anthropic (Anthropic兼容)
LOCAL_ENDPOINT_FORMAT=openai

# --- Claude CLI (BACKEND_TYPE=claude-cli 时使用) ---
# {prompt} 会被替换为实际消息内容
CLAUDE_CLI_CMD=claude -p "{prompt}" --print

# --- 系统提示词 ---
SYSTEM_PROMPT=你是一个有帮助的AI助手。请简洁准确地回答问题，使用中文回复。

# --- 微信配置 ---
# 群聊触发词（为空则仅 @机器人 时触发）
GROUP_TRIGGER=
# 重置上下文的关键词
RESET_KEY=reset
# 保留的对话轮数
MAX_HISTORY=10
